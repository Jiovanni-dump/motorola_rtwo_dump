	fragment@1 {
		target = <0xffffffff>;

		__overlay__ {

			pm8550_tz {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <0x05>;
				phandle = <0x49>;

				trips {

					trip0 {
						temperature = <0x17318>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x4a>;
					};

					trip1 {
